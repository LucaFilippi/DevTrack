    <string name="privacy_intro">DevTrack is a project, task, and personal goal management application designed to operate locally on the user\'s device.</string>
    <string name="privacy_storage_title">1. Data Storage</string>
    <string name="privacy_storage_body">All information entered into the application is stored exclusively on the user\'s device. DevTrack does not use external servers, online accounts, or synchronization services.</string>
    <string name="privacy_policy_title">2. Privacy</string>
    <string name="privacy_policy_body">DevTrack does not collect, transmit, sell, or share personal data or information stored within the application.</string>
    <string name="privacy_responsibility_title">3. Data Responsibility</string>
    <string name="privacy_responsibility_body">Users are responsible for their stored information. Uninstalling the application, clearing its data, or experiencing device failures may result in permanent data loss.</string>
    <string name="privacy_availability_title">4. Availability</string>
    <string name="privacy_availability_body">The application is provided free of charge, as is, without guarantees of uninterrupted operation or freedom from errors.</string>
    <string name="privacy_updates_title">5. Updates</string>
    <string name="privacy_updates_body">These terms may be updated in future releases. Changes to data storage or processing practices will be communicated to users.</string>
    <string name="privacy_acknowledgment">By using DevTrack, users acknowledge these terms.</string>
